# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg

# Tool caches
.pytest_cache/
.ruff_cache/

# Local env / secrets: never commit API keys
.env
.env.*
!.env.example

# Claude Code per-user overrides (the shared .claude/settings.json is committed)
.claude/settings.local.json

# Eval / run output
logs/

# Agent artefacts: the Scout scanners and the checklist's required reports are tracked, never
# the scanners' outputs
agent_artefacts/*
!agent_artefacts/trajectory_analysis/
!agent_artefacts/researcharena_inspect/
!agent_artefacts/researcharena_inspect_*/
agent_artefacts/trajectory_analysis/*
!agent_artefacts/trajectory_analysis/inspect_scout/
agent_artefacts/trajectory_analysis/inspect_scout/scout_results/
agent_artefacts/trajectory_analysis/inspect_scout/logs/
agent_artefacts/trajectory_analysis/inspect_scout/__pycache__/
# This eval's scanners, scripts, analysis files and small result tables are tracked; Scout's raw
# scans (every prompt, transcripts included: about 600 MB for the full pass) and mock runs are not
!agent_artefacts/trajectory_analysis/researcharena_inspect/
agent_artefacts/trajectory_analysis/researcharena_inspect/runs/*/*/scan_id=*/
agent_artefacts/trajectory_analysis/researcharena_inspect/runs/mock-*/
agent_artefacts/trajectory_analysis/researcharena_inspect/__pycache__/

# Editors
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
