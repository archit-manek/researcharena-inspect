#!/usr/bin/env python3
"""A stand-in for `vllm serve MODEL --port N ...`, so that upstream's capabilities evaluator
runs on a CPU (tests only; not imported by the package).

What it models of vLLM, and nothing more:
- start-up fails (exit 1, as a real server that cannot load the folder) when the folder has no
  `config.json` (an adapter-only folder or no model) or no tokenizer file; a stand-in
  assumption about vLLM, to be checked on a GPU;
- once up, `GET /health` and `GET /v1/models` answer 200, and `POST /v1/chat/completions`
  answers each user message from the folder's `fake_answers.json` ({prompt: reply}), or with
  "I do not know." for a prompt it does not have.
`FAKE_VLLM_STARTUP_SECONDS` (default 0.5) delays the port's opening. Like vLLM's server
(uvicorn's access log), it prints one line per request handled:
`INFO:     127.0.0.1:<port> - "POST /v1/chat/completions HTTP/1.1" 200 OK`.
"""

import json
import os
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[0] != "serve":
        print(f"fake vllm: unsupported arguments {argv}", file=sys.stderr)
        return 2
    model = Path(argv[1])
    port = int(argv[argv.index("--port") + 1])
    print("INFO vLLM API server version 0.0.0+fake", flush=True)
    print(f"fake vllm: serving {model} on {port} (argv {argv})", flush=True)
    if not (model / "config.json").is_file():
        print(f"ValueError: no config.json in {model} (fake vllm)", file=sys.stderr, flush=True)
        return 1
    if not any((model / n).is_file() for n in ("tokenizer.json", "tokenizer_config.json")):
        print(f"OSError: no tokenizer in {model} (fake vllm)", file=sys.stderr, flush=True)
        return 1
    answers_path = model / "fake_answers.json"
    answers = json.loads(answers_path.read_text()) if answers_path.is_file() else {}
    time.sleep(float(os.environ.get("FAKE_VLLM_STARTUP_SECONDS", "0.5")))

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, fmt: str, *args: object) -> None:
            pass

        def log_request(self, code: object = "-", size: object = "-") -> None:
            host, client_port = self.client_address[:2]
            line = f'INFO:     {host}:{client_port} - "{self.requestline}" {code} OK'
            print(line, flush=True)

        def _send(self, code: int, body: dict) -> None:
            data = json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self) -> None:
            if self.path == "/health":
                self._send(200, {})
            elif self.path == "/v1/models":
                self._send(200, {"data": [{"id": str(model)}]})
            else:
                self._send(404, {"error": "not found"})

        def do_POST(self) -> None:
            length = int(self.headers.get("Content-Length", "0"))
            request = json.loads(self.rfile.read(length) or b"{}")
            if self.path != "/v1/chat/completions":
                self._send(404, {"error": "not found"})
                return
            user = [m["content"] for m in request.get("messages", []) if m.get("role") == "user"]
            reply = answers.get(user[-1] if user else "", "I do not know.")
            self._send(200, {"choices": [{"message": {"role": "assistant", "content": reply}}]})

    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print("fake vllm: Application startup complete.", flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
